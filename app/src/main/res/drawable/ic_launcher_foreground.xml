<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Circular progress ring with rounded caps and teal-to-mint gradient -->
    <path
        android:pathData="M 60.84,30.16 A 24.8,24.8 0 1,0 76.66,43.91"
        android:strokeWidth="7.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="76"
                android:startY="28"
                android:endX="30"
                android:endY="78"
                android:startColor="#BAF994"
                android:centerColor="#41E79C"
                android:endColor="#00C4A6" />
        </aapt:attr>
    </path>

    <!-- Accent dot in mint/lime -->
    <path
        android:pathData="M 71.76,33.93 m -3.7,0 a 3.7,3.7 0 1,0 7.4,0 a 3.7,3.7 0 1,0 -7.4,0 Z"
        android:fillColor="#9AF58E" />

    <!-- Centered bold white checkmark -->
    <path
        android:pathData="M 41.5,55.0 L 51.5,65.0 L 68.5,47.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

</vector>
